# Names and safe placeholders only. Never put real values here. Copy to .env (git-ignored) for local use.
# Full list and rules: CIRCULAR2ACTION_MASTER_PLAN_v1.1.md section 25.3.

# --- API runtime (read only by apps/api/src/platform/config.ts) ---
NODE_ENV=development
APP_ENV=local
PORT=4000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# free = E0 (dev/test/closed alpha only). paid = E1/E2 (production). Production on "free" is refused at startup.
HOSTING_TIER=free
SCHEDULER_MODE=inprocess
# Below 30 minutes on HOSTING_TIER=free is a keep-alive and is refused (plan SCH-02).
SCHEDULER_INTERVAL_MIN=30
SHUTDOWN_GRACE_SECONDS=100

# Comma-separated, each at least 32 characters; first is current, others are previous (rotation).
INTERNAL_HMAC_SECRETS=replace-me-with-a-random-string-of-32-plus-characters

# --- AI (mock only until gate S-10 passes and the owner approves a paid Gemini project, UQ-3) ---
AI_PROVIDER=mock
AI_ENABLE_PAID=false
AI_ENABLE_FREE=false
AI_MONTHLY_BUDGET_USD=10

# --- Web origins and accounts ---
# Where the browser reaches the API from (the web app's address). Extra origins are comma-separated.
# WEB_ORIGINS_EXTRA=
# Staging only, while no email provider exists: accounts are verified at registration. Production must keep true.
EMAIL_VERIFICATION_REQUIRED=true
# First staff account (read only by `pnpm --filter @c2a/api create-admin`; never commit real values):
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# Demo data (fictional, labelled) is added only with ALLOW_DEMO_SEED=true on `seed --demo`. Never in production.
# ALLOW_DEMO_SEED=

# --- Email (log only until gate S-7 passes and the owner approves a provider account, UQ-10/UQ-16) ---
EMAIL_PROVIDER=log
EMAIL_DAILY_CAP=80
EMAIL_RESERVED_SECURITY_PCT=60

# --- Database (TiDB). Local: `docker compose up -d` then the values below. Staging: TiDB Cloud Starter with TLS. ---
DATABASE_URL=mysql://root@127.0.0.1:4100/c2a_dev
DATABASE_MIGRATION_URL=mysql://root@127.0.0.1:4100/c2a_dev
DATABASE_TLS=false
DATABASE_POOL_SIZE=10

# --- Not yet wired (added with the modules that use them) ---
# STORAGE_ENDPOINT=
# STORAGE_BUCKET_QUARANTINE=
# STORAGE_BUCKET_PRIVATE=
# STORAGE_BUCKET_BACKUPS=
# STORAGE_QUARANTINE_ACCESS_KEY_ID=
# STORAGE_QUARANTINE_SECRET_ACCESS_KEY=
# STORAGE_PRIVATE_ACCESS_KEY_ID=
# STORAGE_PRIVATE_SECRET_ACCESS_KEY=
# GEMINI_API_KEY_FREE=   # DC-A content only
# GEMINI_API_KEY_PAID=
# EMAIL_API_KEY=
# EDGE_SHARED_SECRET=

# Jobs from the web (optional). Arbeitnow and Remotive need no key. Google Programmable Search is off until both are set
# (free tier: 100 queries a day). Create a search engine at https://programmablesearchengine.google.com for the CX id.
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_CX=
# GOOGLE_CSE_QUERY=jobs in Bangladesh
